#. Plugin Name of the plugin
#: ersaal.php
msgid "Ersaal SMS Gateway"
msgstr "بوابة رسائل إرسال"

#. Plugin URI of the plugin
#: ersaal.php
msgid "https://getersaal.com/"
msgstr "https://getersaal.com/"

#. Description of the plugin
#: ersaal.php
msgid ""
"Official Ersaal SMS Gateway integration for WordPress & WooCommerce. Send "
"SMS notifications, verify phone numbers via OTP, and enable 2FA login for "
"Libyan networks."
msgstr ""
"إضافة إرسال الرسمية لووردبريس وWooCommerce. أرسل إشعارات SMS، وتحقق من أرقام "
"الهواتف برمز تحقق لمرة واحدة، وفعّل التحقق بخطوتين عند تسجيل الدخول لأرقام "
"الشبكات الليبية."

#. Author of the plugin
#: ersaal.php
msgid "Lamah"
msgstr "Lamah"

